{
  "manifest_version": 3,
  "name": "WatchFree — client-side ad handler + productivity overlay",
  "version": "0.3.0",
  "description": "Skips client-side YouTube ads and in-video SponsorBlock segments, shows a focus overlay (centered quote + notes), a timestamped learning log, focus sessions, and a stats dashboard.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*", "https://sponsor.ajay.app/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WatchFree settings"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open/close the WatchFree productivity panel"
    },
    "capture-note": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Capture a timestamped note to the learning log"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": [
        "storage.js",
        "statsutil.js",
        "overlay.js",
        "sensor.js",
        "actuators.js",
        "controller.js",
        "sponsorblock.js",
        "learninglog.js",
        "focus.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
